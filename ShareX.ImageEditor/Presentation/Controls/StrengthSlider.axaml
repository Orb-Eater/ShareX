<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="100" d:DesignHeight="40"
             x:Class="ShareX.ImageEditor.Presentation.Controls.StrengthSlider"
             x:Name="StrengthSliderRoot">

    <UserControl.Styles>
        <!-- Transparent at rest so the slot stays the same size and colour. The hover
             wash is the same one the toolbar buttons use, and it is a style (not a
             local value) so it can replace the resting background. -->
        <Style Selector="Border#ValueHost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>
        <Style Selector="Border#ValueHost:pointerover:not(.editing)">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background.Hover}"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="Auto,*" Height="40" VerticalAlignment="Center">
        <!-- The number. Width and margin match the old text block, so the toolbar does not grow. -->
        <Border x:Name="ValueHost"
                Grid.Column="0"
                Width="24"
                Margin="0,0,5,0"
                Cursor="IBeam"
                PointerPressed="OnValuePointerPressed">
            <Grid x:Name="ValueHostGrid">
                <TextBlock x:Name="ValueLabel"
                           Text="{Binding Value, ElementName=StrengthSliderControl, StringFormat='{}{0:F0}'}"
                           Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Stretch"
                           TextAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Slider -->
        <Slider x:Name="StrengthSliderControl"
                Grid.Column="1"
                Minimum="{Binding Minimum, ElementName=StrengthSliderRoot}"
                Maximum="{Binding Maximum, ElementName=StrengthSliderRoot}"
                Value="{Binding SelectedStrength, ElementName=StrengthSliderRoot, Mode=TwoWay}"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                Height="50"
                Width="120"
                Margin="0,0,4,0"
                VerticalAlignment="Center"/>
    </Grid>
</UserControl>
